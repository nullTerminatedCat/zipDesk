1 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION ZIPDESK_VERSION_MAJOR,ZIPDESK_VERSION_MINOR,ZIPDESK_VERSION_PATCH,0
 PRODUCTVERSION ZIPDESK_VERSION_MAJOR,ZIPDESK_VERSION_MINOR,ZIPDESK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "QingXia"
   VALUE "FileDescription", "QingXia Archive Manager"
   VALUE "FileVersion", ZIPDESK_VERSION
   VALUE "InternalName", "ZipDesk"
   VALUE "OriginalFilename", "ZipDesk.exe"
   VALUE "ProductName", "QingXia"
   VALUE "ProductVersion", ZIPDESK_VERSION
   VALUE "LegalCopyright", "Copyright (c) 2026 huanglin2. MIT License."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
